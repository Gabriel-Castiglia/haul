#!/bin/sh
# Haul package: quits a running Haul before it is replaced.
# Copyright (C) 2026 Gabriel Castiglia. Licensed under the GNU GPL, version 2 only.
# SPDX-License-Identifier: GPL-2.0-only
user=$(/usr/bin/stat -f %Su /dev/console)
if /usr/bin/pgrep -xq Haul && [ -n "$user" ] && [ "$user" != root ]; then
    uid=$(/usr/bin/id -u "$user")
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/osascript \
        -e 'tell application id "io.github.gabriel-castiglia.haul" to quit' >/dev/null 2>&1
    sleep 2
fi
/usr/bin/pkill -x Haul 2>/dev/null
exit 0
